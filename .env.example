# Скопируйте в .env и заполните своими значениями. Файл .env игнорируется git.

# API-ключ для облачного LLM-провайдера (Groq / OpenAI / Kluster / Together и т.д.).
# Имеет приоритет над полем "api_key" в echo_sim/config/world.json.
ECHOSIM_API_KEY=

# Токен Telegram-бота от @BotFather (нужен только для telegram_bot.py).
TELEGRAM_BOT_TOKEN=

# Необязательно: каталог для файлов сохранений (по умолчанию "saves").
# ECHOSIM_SAVE_DIR=saves
